SITE_URL=https://blog.mayb.moe
ORIGIN=https://blog.mayb.moe
HOST=0.0.0.0
PORT=3000
BODY_SIZE_LIMIT=16M

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

POSTGRES_DB=mayb_log
POSTGRES_USER=mayb_log
POSTGRES_PASSWORD=replace-with-a-random-password
PGHOST=postgres
PGPORT=5432
PGDATABASE=mayb_log
PGUSER=mayb_log
PGPASSWORD=replace-with-the-same-postgres-password

S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=mayb-log-media
S3_ACCESS_KEY_ID=GKreplace-with-32-hex-characters
S3_SECRET_ACCESS_KEY=replace-with-64-hex-characters
S3_FORCE_PATH_STYLE=true

GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_DEFAULT_ACCESS_KEY=GKreplace-with-32-hex-characters
GARAGE_DEFAULT_SECRET_KEY=replace-with-the-same-s3-secret-key
GARAGE_DEFAULT_BUCKET=mayb-log-media
GARAGE_CONFIG_FILE=./deployment/garage.toml

DATA_ROOT=/volume1/docker/mayb-log/data
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000
MAYB_LOG_IMAGE=ghcr.io/zhdlxh48/mayb-log:main
