{
	"name": "mayb-log",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24.20.0 <25"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "pnpm build && node build",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations",
		"prepare": "pnpm i18n:compile && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run tests/unit",
		"test:smoke": "playwright test",
		"test:migrations": "node scripts/test-migrations.mjs",
		"test": "pnpm test:unit && pnpm test:smoke",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "24.13.4",
		"@types/pg": "8.23.1",
		"drizzle-kit": "0.31.10",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1132.0",
		"@better-auth/drizzle-adapter": "1.7.4",
		"@inlang/paraglide-js": "2.25.1",
		"better-auth": "1.7.4",
		"browser-image-compression": "2.0.2",
		"drizzle-orm": "0.45.2",
		"feed": "6.0.0",
		"hast-util-from-html": "2.0.3",
		"pg": "8.23.0",
		"rehype-highlight": "7.0.2",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"sveltekit-superforms": "2.30.2",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"zod": "4.5.4"
	}
}
