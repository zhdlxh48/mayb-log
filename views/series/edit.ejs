<h1>Edit Series</h1>
<form method="post" action="/series/<%= item.id %>/update">
  <input type="hidden" name="csrf" value="<%= user.csrf_token %>" />
  <table class="form-table">
    <tr>
      <th><label for="title">Name</label></th>
      <td><input id="title" name="title" required maxlength="120" value="<%= item.title %>" /></td>
    </tr>
    <tr>
      <th><label for="description">Description</label></th>
      <td>
        <textarea id="description" name="description" rows="4"><%= item.description %></textarea>
      </td>
    </tr>
  </table>
  <button type="submit">Update</button>
</form>
<form
  method="post"
  action="/series/<%= item.id %>/delete"
  data-confirm="이 시리즈를 삭제하시겠습니까?"
>
  <input type="hidden" name="csrf" value="<%= user.csrf_token %>" /><button
    class="danger"
    type="submit"
  >
    Delete
  </button>
</form>
