<header class="page-header"><h1>Series</h1><a href="/series/new">New Series</a></header>
<table><thead><tr><th>Name</th><th>Posts</th><th>Action</th></tr></thead><tbody>
<% for (const item of series) { %><tr><td><a href="/search?series=<%= item.id %>"><%= item.title %></a><% if (item.description) { %><br><small><%= item.description %></small><% } %></td><td><%= item.post_count %></td><td><a href="/series/<%= item.id %>/edit">Edit</a></td></tr><% } %>
</tbody></table>
<% if (!series.length) { %><p>등록된 시리즈가 없습니다.</p><% } %>
