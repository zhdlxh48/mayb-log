<% if (pager.last > 1) { %>
<nav class="pagination" aria-label="페이지">
  <a href="<%= pageUrl(1) %>" aria-label="첫 페이지">&lt;&lt;</a>
  <% if (pager.previous) { %><a href="<%= pageUrl(pager.previous) %>" aria-label="이전 10페이지">&lt;</a><% } %>
  <% for (const number of pager.pages) { %><a href="<%= pageUrl(number) %>"<% if (number === pager.current) { %> aria-current="page"<% } %>><%= number %></a><% } %>
  <% if (pager.next) { %><a href="<%= pageUrl(pager.next) %>" aria-label="다음 10페이지">&gt;</a><% } %>
  <a href="<%= pageUrl(pager.last) %>" aria-label="마지막 페이지">&gt;&gt;</a>
</nav>
<% } %>
