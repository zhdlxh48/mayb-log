<h1>Sign up</h1>
<% if (message) { %>
<p role="status"><%= message %></p>
<% } %>
<form method="post" action="/signup">
  <table class="form-table">
    <tr>
      <th><label for="username">아이디</label></th>
      <td>
        <input
          id="username"
          name="username"
          required
          minlength="3"
          maxlength="32"
          autocomplete="username"
        />
      </td>
    </tr>
    <tr>
      <th><label for="display_name">닉네임</label></th>
      <td><input id="display_name" name="display_name" required maxlength="80" /></td>
    </tr>
    <tr>
      <th><label for="password">비밀번호</label></th>
      <td>
        <input
          id="password"
          type="password"
          name="password"
          required
          minlength="12"
          autocomplete="new-password"
        />
      </td>
    </tr>
    <tr>
      <th><label for="password_confirmation">비밀번호 확인</label></th>
      <td>
        <input
          id="password_confirmation"
          type="password"
          name="password_confirmation"
          required
          minlength="12"
          autocomplete="new-password"
        />
      </td>
    </tr>
    <tr>
      <th>표시</th>
      <td>
        <label><input id="show-password" type="checkbox" /> 비밀번호 표시</label>
      </td>
    </tr>
  </table>
  <div class="cf-turnstile" data-sitekey="<%= site.turnstileSiteKey %>" data-action="signup"></div>
  <button type="submit">Sign up</button>
</form>
