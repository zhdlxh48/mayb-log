<h1><%= post.id ? 'Edit Post' : 'New Post' %></h1>
<form id="post-form" method="post" enctype="multipart/form-data" action="<%= post.id ? `/posts/${post.id}/update` : '/posts' %>">
  <input type="hidden" name="csrf" value="<%= user.csrf_token %>">
  <input type="hidden" name="post_uuid" value="<%= post.uuid %>">
  <table class="form-table">
    <tr><th><label for="title">Title</label></th><td><input id="title" name="title" required maxlength="200" value="<%= post.title %>"></td></tr>
    <tr><th><label for="subtitle">Subtitle</label></th><td><input id="subtitle" name="subtitle" maxlength="240" value="<%= post.subtitle || '' %>"></td></tr>
    <tr><th><label for="description">Description</label></th><td><textarea id="description" name="description" required rows="3"><%= post.description %></textarea></td></tr>
    <tr><th><label for="series_id">Series</label></th><td><select id="series_id" name="series_id"><option value="">없음</option><% for (const item of series) { %><option value="<%= item.id %>" <%= post.series_id === item.id ? 'selected' : '' %>><%= item.title %></option><% } %></select><br><label for="new_series">새 Series</label> <input id="new_series" name="new_series" maxlength="120"><br><label for="series_position">순서</label> <input id="series_position" type="number" min="1" name="series_position" value="<%= post.series_position || '' %>"></td></tr>
    <tr><th>Categories</th><td><% for (const item of categories) { %><label><input type="checkbox" name="category" value="<%= item.id %>" <%= post.categoryIds.includes(item.id) ? 'checked' : '' %>> <%= item.name %></label><br><% } %><label for="new_categories">새 Categories (쉼표 구분)</label><br><input id="new_categories" name="new_categories"></td></tr>
    <tr><th><label for="tags">Tags</label></th><td><input id="tags" name="tags" value="<%= post.tags.join(', ') %>"></td></tr>
    <tr><th><label for="published_at">Published at</label></th><td><input id="published_at" type="datetime-local" name="published_at" value="<%= post.publishedAtInput %>"></td></tr>
    <tr><th><label for="draft">Draft</label></th><td><input id="draft" type="checkbox" name="draft" value="1" <%= post.draft ? 'checked' : '' %>></td></tr>
    <tr><th><label for="noindex">Noindex</label></th><td><input id="noindex" type="checkbox" name="noindex" value="1" <%= post.noindex ? 'checked' : '' %>></td></tr>
    <tr><th><label for="body_markdown">Markdown</label></th><td><textarea id="body_markdown" name="body_markdown" required rows="24"><%= post.body_markdown %></textarea><br><button id="preview-button" type="button">Preview</button><div id="markdown-preview" class="prose"></div></td></tr>
  </table>

  <fieldset id="image-editor" data-post-uuid="<%= post.uuid %>"><legend>Images</legend>
    <label for="image-files">새 이미지</label> <input id="image-files" type="file" accept="image/*" multiple>
    <div id="pending-images"></div>
    <% if (images.length) { %><h2>Existing Images</h2><div id="existing-images"><% for (const image of images) { %><div class="image-item" data-image-uuid="<%= image.uuid %>"><img src="<%= image.url %>" alt="" loading="lazy"><code><%= image.uuid %>.webp</code> <span data-used></span> <button type="button" data-insert-image="<%= image.url %>">Insert</button> <button type="button" data-delete-image>X</button></div><% } %></div><% } %>
  </fieldset>
  <p id="upload-progress" role="status"></p>
  <button type="submit">Save</button>
</form>
