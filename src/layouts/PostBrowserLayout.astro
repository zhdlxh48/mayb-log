---
import BaseLayout from './BaseLayout.astro';
import PostList from '../components/PostList.astro';
import type { Post } from '../lib/taxonomy.ts';
interface Props { title: string; description: string; posts: Post[] }
const { title, description, posts } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section data-pagefind-body>
    <header class="page-heading"><h1>{title}</h1><p>{description}</p><slot /></header>
    <PostList posts={posts} />
  </section>
</BaseLayout>
