---
import BaseLayout from './BaseLayout.astro';
import PostList from '../components/PostList.astro';
import type { Post } from '../lib/taxonomy.ts';
interface Props {
  title: string;
  description: string;
  posts: Post[];
}
const { title, description, posts } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section>
    <header class="mb-6">
      <h1 class="mb-[10px] text-[28px] leading-[1.35] font-bold tracking-[-0.04em] md:text-[32px]">
        {title}
      </h1>
      <p class="m-0 text-[15px] text-muted">{description}</p>
      <slot />
    </header>
    <PostList posts={posts} />
  </section>
</BaseLayout>
