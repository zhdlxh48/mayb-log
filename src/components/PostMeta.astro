---
import type { Post } from '../lib/taxonomy.ts';
import { slugify } from '../lib/taxonomy.ts';
import { formatDate } from '../lib/dates.ts';
import { url } from '../lib/urls.ts';
interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<div class="flex flex-wrap gap-x-3 gap-y-[5px] text-xs text-muted">
  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
  {
    post.data.tags.map((tag) => (
      <a class="text-muted hover:underline" href={url(`tags/${slugify(tag)}`)}>
        #{tag}
      </a>
    ))
  }
</div>
