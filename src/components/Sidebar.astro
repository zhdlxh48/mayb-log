---
import { getContent } from '../lib/posts.ts';
import { url } from '../lib/urls.ts';
import { site } from '../config/site.ts';
interface Props {
  tagLimit?: number;
}
const { tagLimit = Infinity } = Astro.props;
const data = await getContent();
const current = decodeURI(Astro.url.pathname);
const active = (path: string) => (current === decodeURI(url(path)) ? ('page' as const) : undefined);
const linkClass =
  'flex items-baseline justify-between gap-3 py-[5px] text-foreground wrap-anywhere hover:underline';
const activeClass = 'font-semibold text-accent underline';
const linkClasses = (path?: string) => [
  linkClass,
  path !== undefined && active(path) ? activeClass : '',
];
const countClass = 'shrink-0 text-xs font-normal text-muted tabular-nums';
const labelClass =
  'mb-[5px] block text-[11px] font-semibold tracking-[0.12em] text-muted uppercase hover:underline';
---

<nav class="text-sm leading-normal" aria-label="블로그 Index">
  <ul class="m-0 list-none p-0">
    <li><a class:list={linkClasses('')} href={url()} aria-current={active('')}>About</a></li>
    <li>
      <a class:list={linkClasses('posts')} href={url('posts')} aria-current={active('posts')}>
        전체 글 보기 <span class={countClass}>{data.totalPosts}</span>
      </a>
    </li>
  </ul>
  <div class="mt-6">
    <a
      class:list={[labelClass, active('series') && activeClass]}
      href={url('series')}
      aria-current={active('series')}>Series</a
    >
    <ul class="m-0 list-none p-0">
      {
        data.series.map((entry) => (
          <li>
            <a
              class:list={linkClasses(`series/${entry.id}`)}
              href={url(`series/${entry.id}`)}
              aria-current={active(`series/${entry.id}`)}
            >
              {entry.data.title}
              <span class={countClass}>{entry.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-6">
    <a
      class:list={[labelClass, active('categories') && activeClass]}
      href={url('categories')}
      aria-current={active('categories')}>Categories</a
    >
    <ul class="m-0 list-none p-0">
      {
        data.categories.map((entry) => (
          <li>
            <a
              class:list={linkClasses(`categories/${entry.slug}`)}
              href={url(`categories/${entry.slug}`)}
              aria-current={active(`categories/${entry.slug}`)}
            >
              {entry.name}
              <span class={countClass}>{entry.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-6">
    <a
      class:list={[labelClass, active('tags') && activeClass]}
      href={url('tags')}
      aria-current={active('tags')}>Tags</a
    >
    <ul class="m-0 list-none p-0">
      {
        data.tags.slice(0, tagLimit).map((entry) => (
          <li>
            <a
              class:list={linkClasses(`tags/${entry.slug}`)}
              href={url(`tags/${entry.slug}`)}
              aria-current={active(`tags/${entry.slug}`)}
            >
              {entry.name}
              <span class={countClass}>{entry.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-6">
    <a
      class:list={[labelClass, active('archive') && activeClass]}
      href={url('archive')}
      aria-current={active('archive')}>Archive</a
    >
    <ul class="m-0 list-none p-0">
      {
        data.archive.map((entry) => (
          <li>
            <a
              class:list={linkClasses(`archive/${entry.year}`)}
              href={url(`archive/${entry.year}`)}
              aria-current={active(`archive/${entry.year}`)}
            >
              {entry.year}
              <span class={countClass}>{entry.count}</span>
            </a>
            <ul class="m-0 list-none py-0 pr-0 pl-[14px]">
              {entry.months.map((month) => (
                <li>
                  <a
                    class:list={linkClasses(`archive/${entry.year}/${month.month}`)}
                    href={url(`archive/${entry.year}/${month.month}`)}
                    aria-current={active(`archive/${entry.year}/${month.month}`)}
                  >
                    {month.month}월<span class={countClass}>{month.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
  <ul class="mt-[26px] list-none border-t border-border px-0 pt-[15px]">
    <li>
      <a class:list={linkClasses('search')} href={url('search')} aria-current={active('search')}
        >Search</a
      >
    </li>
    <li><a class={linkClass} href={url('rss.xml')}>RSS</a></li>
    <li><a class={linkClass} href={site.github}>GitHub ↗</a></li>
  </ul>
</nav>
