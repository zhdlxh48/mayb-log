---
import { getContent } from '../lib/posts.ts';
import { url } from '../lib/urls.ts';
import { site } from '../config/site.ts';
interface Props { tagLimit?: number }
const { tagLimit = Infinity } = Astro.props;
const data = await getContent();
const current = decodeURI(Astro.url.pathname);
const active = (path: string) => current === decodeURI(url(path)) ? 'page' as const : undefined;
---
<nav class="index-nav" aria-label="블로그 Index" data-pagefind-ignore>
  <ul>
    <li><a href={url()} aria-current={active('')}>About</a></li>
    <li><a href={url('posts')} aria-current={active('posts')}>전체 글 보기 <span class="count">{data.totalPosts}</span></a></li>
  </ul>
  <div class="index-section">
    <a class="index-label" href={url('series')} aria-current={active('series')}>Series</a>
    <ul>{data.series.map(entry => <li><a href={url(`series/${entry.id}`)} aria-current={active(`series/${entry.id}`)}>{entry.data.title}<span class="count">{entry.count}</span></a></li>)}</ul>
  </div>
  <div class="index-section">
    <a class="index-label" href={url('categories')} aria-current={active('categories')}>Categories</a>
    <ul>{data.categories.map(entry => <li><a href={url(`categories/${entry.slug}`)} aria-current={active(`categories/${entry.slug}`)}>{entry.name}<span class="count">{entry.count}</span></a></li>)}</ul>
  </div>
  <div class="index-section">
    <a class="index-label" href={url('tags')} aria-current={active('tags')}>Tags</a>
    <ul>{data.tags.slice(0, tagLimit).map(entry => <li><a href={url(`tags/${entry.slug}`)} aria-current={active(`tags/${entry.slug}`)}>{entry.name}<span class="count">{entry.count}</span></a></li>)}</ul>
  </div>
  <div class="index-section">
    <a class="index-label" href={url('archive')} aria-current={active('archive')}>Archive</a>
    <ul>{data.archive.map(entry => <li>
      <a href={url(`archive/${entry.year}`)} aria-current={active(`archive/${entry.year}`)}>{entry.year}<span class="count">{entry.count}</span></a>
      <ul class="index-months">{entry.months.map(month => <li><a href={url(`archive/${entry.year}/${month.month}`)} aria-current={active(`archive/${entry.year}/${month.month}`)}>{month.month}월<span class="count">{month.count}</span></a></li>)}</ul>
    </li>)}</ul>
  </div>
  <ul class="index-secondary">
    <li><a href={url('search')} aria-current={active('search')}>Search</a></li>
    <li><a href={url('rss.xml')}>RSS</a></li>
    <li><a href={site.github}>GitHub ↗</a></li>
  </ul>
</nav>
