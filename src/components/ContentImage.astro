---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageOptions } from '../lib/images.ts';
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  priority?: boolean;
}
const {
  src,
  alt,
  sizes = '(max-width: 767px) calc(100vw - 40px), 720px',
  priority = false,
  class: className,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  {...imageOptions(src)}
  class={className}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
/>
