---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  headings.length > 0 && (
    <aside class="mb-6 text-[13px] text-muted min-[1280px]:sticky min-[1280px]:top-7 min-[1280px]:col-start-2 min-[1280px]:row-start-1 min-[1280px]:mb-0 min-[1280px]:max-h-[calc(100dvh-56px)] min-[1280px]:overflow-y-auto">
      <details open>
        <summary class="cursor-pointer py-2 text-foreground">목차</summary>
        <nav aria-label="글 목차">
          <ul class="m-0 list-none py-2">
            {headings.map((heading) => (
              <li class:list={['my-[6px]', { 'pl-[14px]': heading.depth === 3 }]}>
                <a class="text-muted hover:underline" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </aside>
  )
}
