---
import type { Post } from '../lib/taxonomy.ts';
import PostListItem from './PostListItem.astro';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<div
  class="group/browser [&[data-view=grid]_.post-list]:grid [&[data-view=grid]_.post-list]:grid-cols-1 [&[data-view=grid]_.post-list]:gap-x-7 md:[&[data-view=grid]_.post-list]:grid-cols-2 min-[1400px]:[&[data-view=grid]_.post-list]:grid-cols-3 [&[data-view=grid]_.post-item]:block [&[data-view=grid]_.post-thumbnail]:mb-4 [&[data-view=grid]_.post-thumbnail_img]:h-auto"
  data-post-browser
>
  <div class="flex items-center justify-between border-b border-border py-3 text-[13px]">
    <span class="text-muted">{posts.length}개의 글</span>
    <div class="flex gap-1" role="group" aria-label="목록 표시 방식" hidden>
      <button
        class="cursor-pointer rounded-[2px] border border-transparent px-[9px] py-[3px] text-muted aria-pressed:border-border aria-pressed:bg-sidebar aria-pressed:text-foreground"
        type="button"
        data-view="list"
        aria-pressed="true">List</button
      >
      <button
        class="cursor-pointer rounded-[2px] border border-transparent px-[9px] py-[3px] text-muted aria-pressed:border-border aria-pressed:bg-sidebar aria-pressed:text-foreground"
        type="button"
        data-view="grid"
        aria-pressed="false">Grid</button
      >
    </div>
  </div>
  {
    posts.length ? (
      <ul class="post-list m-0 list-none p-0">
        {posts.map((post) => (
          <PostListItem post={post} />
        ))}
      </ul>
    ) : (
      <p class="py-[35px] text-muted">아직 작성된 글이 없습니다.</p>
    )
  }
</div>
<script>
  const browser = document.querySelector<HTMLElement>('[data-post-browser]');
  if (browser) {
    const controls = browser.querySelector<HTMLElement>('[role="group"]')!;
    const buttons = controls.querySelectorAll<HTMLButtonElement>('button');
    const applyView = (value: string) => {
      browser.dataset.view = value === 'grid' ? 'grid' : 'list';
      buttons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.view === browser.dataset.view)),
      );
    };
    try {
      applyView(localStorage.getItem('post-view') ?? 'list');
    } catch {
      applyView('list');
    }
    controls.hidden = false;
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        applyView(button.dataset.view!);
        try {
          localStorage.setItem('post-view', browser.dataset.view!);
        } catch {
          // Private storage must not block the view toggle.
        }
      }),
    );
  }
</script>
