---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent } from '../../lib/posts.ts';
import { url } from '../../lib/urls.ts';
const entries = (await getContent()).categories;
---
<BaseLayout title="Categories" description="분류별로 기록을 찾아보세요.">
  <section data-pagefind-body>
    <h1>Categories</h1><p class="muted">분류별로 모은 기록입니다.</p>
    <ul class="taxonomy-index">{entries.map(entry => <li><a href={url(`categories/${entry.slug}`)}>{entry.name} <span class="count">{entry.count}</span></a></li>)}</ul>
    {!entries.length && <p class="empty-state">아직 등록된 분류가 없습니다.</p>}
  </section>
</BaseLayout>
