---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEARCH_FILTERS } from '../lib/search-view';
import { url } from '../lib/urls';
---

<BaseLayout title="Search" description="블로그의 글과 분류를 검색합니다." noindex>
  <h1 class="mb-[22px] text-[28px] leading-[1.35] font-bold tracking-[-0.04em] md:text-[32px]">
    Search
  </h1>
  <form class="my-6 max-w-[720px]" role="search" data-search-source={url('search-data')}>
    <label class="mb-2 block text-sm" for="search-input">글과 분류 검색</label>
    <div class="flex gap-2">
      <input
        class="min-w-0 flex-1 rounded-[2px] border border-border px-3 py-[10px]"
        id="search-input"
        name="q"
        type="search"
        placeholder="검색어를 입력하세요"
        autocomplete="off"
      />
      <button
        class="cursor-pointer rounded-[2px] border border-border bg-sidebar px-4 py-2"
        type="submit">검색</button
      >
    </div>
  </form>
  <nav
    id="search-filters"
    class="mb-5 flex max-w-[720px] flex-wrap gap-x-4 gap-y-2 border-b border-border pb-3 text-sm"
    aria-label="Search result filters"
    hidden
  >
    {
      SEARCH_FILTERS.map((filter) => (
        <button
          class="cursor-pointer text-muted disabled:cursor-default disabled:opacity-45"
          type="button"
          data-search-filter={filter.kind}
          aria-pressed="false"
          disabled
        >
          {filter.label} <span data-search-count>0</span>
        </button>
      ))
    }
  </nav>
  <p id="search-status" class="text-muted" role="status" aria-live="polite">
    검색어를 입력하면 결과가 표시됩니다.
  </p>
  <noscript>
    <p>검색에는 JavaScript가 필요합니다. Index에서 분류와 날짜별로 글을 찾아볼 수 있습니다.</p>
  </noscript>
  <div id="search-results" class="max-w-[720px]"></div>
</BaseLayout>

<script>
  import { isSearchKind, type SearchDocument, type SearchKind } from '../lib/search';
  import { buildSearchDocumentText, extractVisibleText, readSearchList } from '../lib/search-text';
  import {
    getPageItems,
    getPagination,
    getSearchCounts,
    groupSearchResults,
    isSearchFilter,
    RESULT_KINDS,
    SEARCH_FILTERS,
    SUMMARY_LIMIT,
    type SearchFilter,
  } from '../lib/search-view';

  const form = document.querySelector<HTMLFormElement>('[data-search-source]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const filters = document.querySelector<HTMLElement>('#search-filters')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  const filterButtons = [...filters.querySelectorAll<HTMLButtonElement>('[data-search-filter]')];

  let workerPromise: Promise<Worker> | undefined;
  let requestId = 0;
  let timer = 0;
  let currentQuery = '';
  let currentResults: SearchDocument[] = [];
  let currentFilter: SearchFilter = 'all';
  let currentPage = 1;
  let hasSearched = false;

  async function initializeWorker() {
    const response = await fetch(form.dataset.searchSource!);
    if (!response.ok) throw new Error(`검색 데이터를 불러올 수 없습니다 (${response.status}).`);

    const source = new DOMParser().parseFromString(await response.text(), 'text/html');
    const documents: SearchDocument[] = [];
    for (const element of source.querySelectorAll<HTMLElement>('[data-search-document]')) {
      if (!isSearchKind(element.dataset.kind)) continue;
      const kind = element.dataset.kind;
      const title = element.dataset.title ?? '';
      const description = element.dataset.description ?? '';
      documents.push({
        id: documents.length,
        kind,
        url: element.dataset.url ?? '',
        title,
        description,
        text: buildSearchDocumentText(kind, {
          title,
          name: element.dataset.name,
          subtitle: element.dataset.subtitle,
          description,
          body: extractVisibleText(element.querySelector('[data-search-body]')),
          tags: readSearchList(element.dataset.tags),
          categories: readSearchList(element.dataset.categories),
          series: element.dataset.series,
          authors: readSearchList(element.dataset.authors),
          publishedAt: element.dataset.publishedAt,
        }),
      });
    }

    const worker = new Worker(new URL('../workers/search.worker.ts', import.meta.url), {
      type: 'module',
    });
    try {
      await new Promise<void>((resolve, reject) => {
        worker.addEventListener('message', (event) => event.data.type === 'ready' && resolve(), {
          once: true,
        });
        worker.addEventListener(
          'error',
          () => reject(new Error('검색 작업자를 시작하지 못했습니다.')),
          { once: true },
        );
        worker.postMessage({ type: 'initialize', documents });
      });
      return worker;
    } catch (error) {
      worker.terminate();
      throw error;
    }
  }

  function startWorker() {
    workerPromise ??= initializeWorker().catch((error) => {
      workerPromise = undefined;
      throw error;
    });
    return workerPromise;
  }

  function searchWorker(worker: Worker, query: string, currentRequest: number) {
    return new Promise<SearchDocument[]>((resolve, reject) => {
      const onMessage = (event: MessageEvent) => {
        if (event.data.type !== 'results' || event.data.requestId !== currentRequest) return;
        cleanup();
        resolve(event.data.documents);
      };
      const onError = () => {
        cleanup();
        reject(new Error('검색 중 오류가 발생했습니다.'));
      };
      const cleanup = () => {
        worker.removeEventListener('message', onMessage);
        worker.removeEventListener('error', onError);
      };
      worker.addEventListener('message', onMessage);
      worker.addEventListener('error', onError);
      worker.postMessage({ type: 'search', requestId: currentRequest, query });
    });
  }

  function readUrlState() {
    const parameters = new URLSearchParams(location.search);
    const query = parameters.get('q')?.trim() ?? '';
    const type = parameters.get('type');
    const filter: SearchFilter = isSearchFilter(type) ? type : 'all';
    const rawPage = parameters.get('page');
    const page = filter !== 'all' && rawPage && /^\d+$/.test(rawPage) ? Number(rawPage) : 1;
    return { query, filter, page: page > 0 ? page : 1 };
  }

  function writeUrl(mode: 'push' | 'replace') {
    const address = new URL(location.href);
    address.search = '';
    if (currentQuery) address.searchParams.set('q', currentQuery);
    if (currentQuery && currentFilter !== 'all') {
      address.searchParams.set('type', currentFilter);
      if (currentPage > 1) address.searchParams.set('page', String(currentPage));
    }
    if (mode === 'push') history.pushState({}, '', address);
    else history.replaceState({}, '', address);
  }

  function updateFilters() {
    const counts = getSearchCounts(currentResults);
    filters.hidden = false;
    for (const button of filterButtons) {
      const kind = button.dataset.searchFilter as SearchFilter;
      const count = counts[kind];
      button.querySelector<HTMLElement>('[data-search-count]')!.textContent = String(count);
      button.disabled = count === 0;
      button.setAttribute('aria-pressed', String(kind === currentFilter));
      button.classList.toggle('font-semibold', kind === currentFilter);
      button.classList.toggle('text-foreground', kind === currentFilter);
      button.classList.toggle('text-muted', kind !== currentFilter);
    }
  }

  function createResultList(documents: SearchDocument[]) {
    const list = document.createElement('ul');
    list.className = 'list-none p-0';
    list.append(
      ...documents.map((entry) => {
        const item = document.createElement('li');
        item.className = 'border-b border-border py-5';
        item.dataset.searchResultKind = entry.kind;
        const heading = document.createElement('h3');
        heading.className = 'mb-2 text-[19px] font-semibold';
        const link = document.createElement('a');
        link.className = 'text-accent hover:underline';
        link.href = entry.url;
        link.textContent = entry.title;
        heading.append(link);
        item.append(heading);
        if (entry.description) {
          const description = document.createElement('p');
          description.className = 'm-0 text-sm text-muted';
          description.textContent = entry.description;
          item.append(description);
        }
        return item;
      }),
    );
    return list;
  }

  function createSection(kind: Exclude<SearchKind, 'about'>, documents: SearchDocument[]) {
    const section = document.createElement('section');
    section.className = 'mt-8';
    section.dataset.searchSection = kind;
    const heading = document.createElement('h2');
    heading.className = 'border-b border-border pb-3 text-[19px] font-semibold';
    const label = SEARCH_FILTERS.find((filter) => filter.kind === kind)!.label;
    heading.textContent = `${label} · ${documents.length}`;
    section.append(heading);
    return section;
  }

  function selectFilter(filter: SearchFilter, mode: 'push' | 'replace' = 'push') {
    currentFilter = filter;
    currentPage = 1;
    renderResults();
    writeUrl(mode);
  }

  function createMoreButton(kind: Exclude<SearchKind, 'about'>) {
    const button = document.createElement('button');
    button.className = 'mt-3 cursor-pointer text-sm text-accent hover:underline';
    button.type = 'button';
    button.textContent = 'More →';
    button.addEventListener('click', () => selectFilter(kind));
    return button;
  }

  function createPageButton(label: string, target: number | null, ariaLabel: string) {
    const button = document.createElement('button');
    button.className =
      'min-w-7 cursor-pointer px-1 py-1 text-sm disabled:cursor-default disabled:opacity-35';
    button.type = 'button';
    button.textContent = label;
    button.setAttribute('aria-label', ariaLabel);
    button.disabled = target === null;
    if (target !== null) {
      button.addEventListener('click', () => {
        currentPage = target;
        renderResults();
        writeUrl('push');
      });
    }
    return button;
  }

  function createPagination(totalItems: number) {
    const pagination = getPagination(totalItems, currentPage);
    currentPage = pagination.currentPage;
    if (pagination.totalPages <= 1) return null;

    const navigation = document.createElement('nav');
    navigation.className = 'mt-6 flex flex-wrap items-center gap-1';
    navigation.setAttribute('aria-label', 'Search result pages');
    navigation.append(
      createPageButton('<<', pagination.firstPage, 'First page'),
      createPageButton('<', pagination.previousGroupPage, 'Previous page group'),
    );
    for (const page of pagination.pages) {
      const button = createPageButton(
        String(page),
        page === currentPage ? null : page,
        `Page ${page}`,
      );
      if (page === currentPage) {
        button.setAttribute('aria-current', 'page');
        button.classList.add('font-semibold', 'text-foreground');
      }
      navigation.append(button);
    }
    navigation.append(
      createPageButton('>', pagination.nextGroupPage, 'Next page group'),
      createPageButton('>>', pagination.lastPage, 'Last page'),
    );
    return navigation;
  }

  function renderResults() {
    results.replaceChildren();
    const counts = getSearchCounts(currentResults);
    if (currentFilter !== 'all' && counts[currentFilter] === 0) currentFilter = 'all';
    updateFilters();
    if (!currentResults.length) {
      status.textContent = '검색 결과가 없습니다.';
      return;
    }

    status.textContent = `${currentResults.length}개의 검색 결과`;
    const groups = groupSearchResults(currentResults);
    if (currentFilter === 'all') {
      currentPage = 1;
      if (groups.about.length) {
        const about = document.createElement('section');
        about.className = 'mt-5';
        about.dataset.searchSection = 'about';
        about.setAttribute('aria-label', 'About');
        about.append(createResultList(groups.about));
        results.append(about);
      }
      for (const kind of RESULT_KINDS) {
        const documents = groups[kind];
        if (!documents.length) continue;
        const section = createSection(kind, documents);
        section.append(createResultList(documents.slice(0, SUMMARY_LIMIT)));
        if (documents.length > SUMMARY_LIMIT) section.append(createMoreButton(kind));
        results.append(section);
      }
      return;
    }

    const documents = groups[currentFilter];
    const page = getPageItems(documents, currentPage);
    currentPage = page.pagination.currentPage;
    const section = createSection(currentFilter, documents);
    section.append(createResultList(page.items));
    const pagination = createPagination(documents.length);
    if (pagination) section.append(pagination);
    results.append(section);
  }

  async function runSearch(
    query: string,
    filter: SearchFilter,
    page: number,
    historyMode?: 'push' | 'replace',
  ) {
    const searchQuery = query.trim();
    currentQuery = searchQuery;
    currentFilter = currentQuery ? filter : 'all';
    currentPage = currentFilter === 'all' ? 1 : page;
    input.value = currentQuery;
    if (historyMode) writeUrl(historyMode);

    if (!currentQuery) {
      requestId++;
      currentResults = [];
      hasSearched = false;
      filters.hidden = true;
      results.replaceChildren();
      status.textContent = '검색어를 입력하면 결과가 표시됩니다.';
      return;
    }

    const currentRequest = ++requestId;
    filters.hidden = true;
    results.replaceChildren();
    status.textContent = '검색하는 중…';
    try {
      const worker = await startWorker();
      const documents = await searchWorker(worker, searchQuery, currentRequest);
      if (currentRequest !== requestId) return;
      currentResults = documents;
      hasSearched = true;
      renderResults();
      writeUrl('replace');
    } catch {
      if (currentRequest !== requestId) return;
      currentResults = [];
      hasSearched = false;
      filters.hidden = true;
      results.replaceChildren();
      status.textContent = '검색을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
    }
  }

  function searchNewQuery(mode: 'push' | 'replace') {
    runSearch(input.value, 'all', 1, mode);
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(timer);
    searchNewQuery('push');
  });

  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => searchNewQuery('replace'), 180);
  });

  filters.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-search-filter]');
    if (!button || button.disabled) return;
    selectFilter(button.dataset.searchFilter as SearchFilter);
  });

  addEventListener('popstate', () => {
    window.clearTimeout(timer);
    const state = readUrlState();
    input.value = state.query;
    if (hasSearched && state.query === currentQuery) {
      currentFilter = state.filter;
      currentPage = state.page;
      renderResults();
      return;
    }
    runSearch(state.query, state.filter, state.page);
  });

  const initialState = readUrlState();
  input.value = initialState.query;
  if (initialState.query) {
    runSearch(initialState.query, initialState.filter, initialState.page);
  }
</script>
