---
import { getEntry, render } from 'astro:content';
import { getContent } from '../lib/posts';
import { url } from '../lib/urls';

const data = await getContent();
const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md 또는 about.mdx가 필요합니다.');
const { Content: AboutContent } = await render(about);

const posts = await Promise.all(
  data.posts.map(async (post) => ({ post, rendered: await render(post) })),
);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>검색 데이터</title>
    <meta name="description" content="mayb-log의 검색용 본문 데이터입니다." />
  </head>
  <body>
    <main>
      <article
        data-search-document
        data-kind="about"
        data-url={url()}
        data-title={about.data.title}
        data-description={about.data.description}
      >
        <div data-search-body><AboutContent /></div>
      </article>

      {
        posts.map(({ post, rendered }) => {
          const authors = post.data.authors.map(
            (reference) => data.authors.find((author) => author.id === reference.id)!.data.name,
          );
          const series = data.series.find((entry) => entry.id === post.data.series?.id)?.data.title;
          return (
            <article
              data-search-document
              data-kind="post"
              data-url={url(`posts/${post.id}`)}
              data-title={post.data.title}
              data-subtitle={post.data.subtitle}
              data-description={post.data.description}
              data-authors={JSON.stringify(authors)}
              data-series={series}
              data-categories={JSON.stringify(post.data.categories)}
              data-tags={JSON.stringify(post.data.tags)}
              data-published-at={post.data.publishedAt.toISOString()}
              data-noindex={String(post.data.seo.noindex)}
            >
              <div data-search-body>
                <rendered.Content />
              </div>
            </article>
          );
        })
      }

      {
        data.series.map((entry) => (
          <article
            data-search-document
            data-kind="series"
            data-url={url(`series/${entry.id}`)}
            data-title={entry.data.title}
            data-description={
              entry.data.description ?? `${entry.count}개의 글이 이어지는 시리즈입니다.`
            }
          />
        ))
      }
      {
        data.categories.map((entry) => (
          <article
            data-search-document
            data-kind="category"
            data-url={url(`categories/${entry.slug}`)}
            data-name={entry.name}
            data-title={`${entry.name} 분류`}
            data-description={`${entry.name} 분류의 글 ${entry.count}개`}
          />
        ))
      }
      {
        data.tags.map((entry) => (
          <article
            data-search-document
            data-kind="tag"
            data-url={url(`tags/${entry.slug}`)}
            data-name={entry.name}
            data-title={`${entry.name} 태그`}
            data-description={`${entry.name} 태그의 글 ${entry.count}개`}
          />
        ))
      }
      {
        data.authors.map((author) => (
          <article
            data-search-document
            data-kind="author"
            data-url={url(`authors/${author.id}`)}
            data-title={author.data.name}
            data-description={author.data.bio ?? `${author.data.name}의 글`}
          />
        ))
      }
      {
        data.archive.map((entry) => (
          <article
            data-search-document
            data-kind="archive"
            data-url={url(`archive/${entry.year}`)}
            data-title={`${entry.year}년 Archive`}
            data-description={`${entry.year}년에 작성한 글 ${entry.count}개`}
          />
        ))
      }
      {
        data.archive.flatMap((entry) =>
          entry.months.map((month) => (
            <article
              data-search-document
              data-kind="archive"
              data-url={url(`archive/${entry.year}/${month.month}`)}
              data-title={`${entry.year}년 ${month.month}월 Archive`}
              data-description={`${entry.year}년 ${month.month}월에 작성한 글 ${month.count}개`}
            />
          )),
        )
      }
    </main>
  </body>
</html>
