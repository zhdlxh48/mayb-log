---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent } from '../../lib/posts.ts';
import { url } from '../../lib/urls.ts';
const { archive } = await getContent();
---

<BaseLayout title="Archive" description="연도와 월을 따라 기록을 찾아보세요.">
  <section>
    <h1 class="mb-[22px] text-[28px] leading-[1.35] font-bold tracking-[-0.04em] md:text-[32px]">
      Archive
    </h1><p class="text-muted">서울 시간 기준, 발행일 순으로 모은 기록입니다.</p>
    <ul class="my-7 max-w-[720px] list-none p-0">
      {
        archive.map((entry) => (
          <li class="border-b border-border py-[14px]">
            <a
              class="flex justify-between gap-3 text-accent hover:underline"
              href={url(`archive/${entry.year}`)}
            >
              {entry.year}년{' '}
              <span class="shrink-0 text-xs text-muted tabular-nums">{entry.count}</span>
            </a>
            <ul class="list-none pt-[10px] pl-5 text-sm">
              {entry.months.map((month) => (
                <li class="py-[5px]">
                  <a
                    class="flex justify-between gap-3 text-accent hover:underline"
                    href={url(`archive/${entry.year}/${month.month}`)}
                  >
                    {month.month}월{' '}
                    <span class="shrink-0 text-xs text-muted tabular-nums">{month.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    {!archive.length && <p class="py-[35px] text-muted">아직 작성된 글이 없습니다.</p>}
  </section>
</BaseLayout>
