---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleProse from '../components/ArticleProse.astro';
const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md가 필요합니다.');
const { Content } = await render(about);
---

<BaseLayout description={about.data.description}>
  <ArticleProse class="about">
    <h1>{about.data.title}</h1>
    <Content />
  </ArticleProse>
</BaseLayout>
