---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/urls.ts';
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다." noindex>
  <h1 class="mb-[22px] text-[28px] leading-[1.35] font-bold tracking-[-0.04em] md:text-[32px]">
    404
  </h1>
  <p>페이지를 찾을 수 없습니다.</p>
  <ul class="my-6 flex list-none gap-5 p-0">
    <li><a class="text-accent hover:underline" href={url()}>About</a></li><li>
      <a class="text-accent hover:underline" href={url('posts')}>전체 글 보기</a>
    </li><li><a class="text-accent hover:underline" href={url('search')}>Search</a></li>
  </ul>
</BaseLayout>
