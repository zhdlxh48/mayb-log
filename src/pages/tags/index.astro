---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent } from '../../lib/posts.ts';
import { url } from '../../lib/urls.ts';
const entries = (await getContent()).tags;
---

<BaseLayout title="Tags" description="태그별로 기록을 찾아보세요.">
  <section>
    <h1 class="mb-[22px] text-[28px] leading-[1.35] font-bold tracking-[-0.04em] md:text-[32px]">
      Tags
    </h1><p class="text-muted">태그별로 모은 기록입니다.</p>
    <ul class="my-7 max-w-[720px] list-none p-0">
      {
        entries.map((entry) => (
          <li class="border-b border-border py-[14px]">
            <a
              class="flex justify-between gap-3 text-accent hover:underline"
              href={url(`tags/${entry.slug}`)}
            >
              {entry.name}{' '}
              <span class="shrink-0 text-xs text-muted tabular-nums">{entry.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
    {!entries.length && <p class="py-[35px] text-muted">아직 등록된 태그가 없습니다.</p>}
  </section>
</BaseLayout>
